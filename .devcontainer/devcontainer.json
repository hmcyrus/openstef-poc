{
    "name": "Python 3.11 Dev Container",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",

    "features": {
      "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },

    "_postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",

    "postStartCommand": "cd dpdc_openstef && docker compose up -d",

    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-python.vscode-pylance"
        ]
      }
    }
  }
  